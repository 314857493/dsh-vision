{
  "name": "dsh-vision-free-eyes",
  "version": "0.1.3",
  "description": "DeepSeek Harness plugin: a model-facing `vision` tool that describes and OCRs image files by calling the free Zhipu GLM vision API directly (no external CLI required).",
  "license": "MIT",
  "keywords": [
    "dsh",
    "deepseek",
    "deepseek-harness",
    "plugin",
    "dsh-plugin",
    "vision",
    "image",
    "glm",
    "zhipu",
    "ocr"
  ],
  "engines": {
    "node": ">=22"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./cordis.patch.yml": "./cordis.patch.yml",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node test/suite.mjs"
  },
  "files": [
    "index.js",
    "cordis.patch.yml",
    "README.md",
    "SECURITY.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/314857493/dsh-vision.git"
  },
  "homepage": "https://github.com/314857493/dsh-vision#readme",
  "bugs": {
    "url": "https://github.com/314857493/dsh-vision/issues"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.0-rc.8 <0.2.0",
      "profiles": [
        "web"
      ],
      "dshReleases": {
        "0.1.0-rc.8": "compatible",
        "0.1.1-rc.1": "compatible",
        "0.1.1-rc.2": "compatible"
      }
    }
  }
}
